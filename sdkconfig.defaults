# Board settings layered after alternative/tailnet/sdkconfig.defaults. 16 MB flash is set there.
# Flash timing: the tested T-Dongle-S3 (Winbond W25Q128) boot-loops at QIO 80 MHz, and ESP-IDF's
# default for this target is 80 MHz, so pin DIO at 40 MHz explicitly. tools/check_build.py
# verifies the bootloader and app image headers carry exactly this.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
# Reproducible builds: no compile timestamps in the app image.
CONFIG_APP_REPRODUCIBLE_BUILD=y
