CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ML_MAX_PEERS=8
CONFIG_ML_H2_BUFFER_SIZE_KB=64
CONFIG_ML_JSON_BUFFER_SIZE_KB=64
CONFIG_ML_ENABLE_CELLULAR=n
CONFIG_ML_ZERO_COPY_WG=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=2
# 3,200 B (esp_tinyusb's default; two full frames per NTB) instead of 6,400: the 6.4 KB saved pays
# for the transmit ring and its worker so the boot heap, and with it the membership admission
# margin, does not shrink. The ring now absorbs bursts that the larger NTBs used to. ADR 0015.
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=3200
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192

# TCP window: 8 x MSS (11,520 B) instead of 4 x (5,760 B). The window is global (IDF lwIP has no
# per-socket window option and window scaling needs SPIRAM), so it is sized for the DERP relay
# sockets, the only ones that ever need more than 2-3 segments in flight, and bounded by what
# the Wi-Fi RX pool can pin. The receive mailbox must be WND/MSS + 2. tools/test-tcp-window.py
# and main/tcp_window_budget.h reject inconsistent values. See docs/adr/0015-data-plane-io.md.
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=10
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16

CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Management/DNS reservation and dynamic membership admission use this total.
CONFIG_LWIP_MAX_SOCKETS=20

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128

# Match the upstream router startup headroom; this stack is freed when app_main returns.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168

# Crash evidence survives USB detach; capture only the failing task, no DRAM dump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=1
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=n
CONFIG_ESP_COREDUMP_LOGS=n

CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64

CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
