# Hold opens the menu, short steps, hold runs `use 2`; then setup, then exit.
start 1000
set saved 3
set saved_wifi 1
set online 1
set wifi 1
set usb 1
set name1 Home
set name2 Phone hotspot
set name3 A network with a very long display name
press 2000 3700
press 4000 4100
press 5000 5100
press 6000 7700
press 9000 10700
press 12000 13700
press 14000 14100
press 15000 15100
press 16000 16100
press 17000 17100
press 18000 18100
press 19000 20700
tick 1000 24000 20
