# The backlight dims after dim_seconds idle; the press that wakes it is swallowed whole (no page change); the next one works.
start 1000
set dim_seconds 10
set brightness 80
set saved 1
set saved_wifi 1
set online 1
set wifi 1
set usb 1
press 13000 13100
press 14000 14100
press 30000 31700
press 32000 32100
tick 1000 40000 20
set brightness 5
set rotation 1
press 41000 41100
tick 40000 48000 20
