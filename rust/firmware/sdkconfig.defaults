# ESP-IDF configuration of the Rust firmware (esp-idf-sys reads this file; see ../../alternative/tailnet/sdkconfig.defaults and ../../sdkconfig.defaults
# for the C firmware's, which this follows wherever the bridge mode is concerned). Only what differs from the esp-idf-sys defaults is listed.

# ---- Board: ESP32-S3, 16 MB flash, no PSRAM -----------------------------------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=n
# Flash timing: the tested T-Dongle-S3 (Winbond W25Q128) boot-loops at QIO 80 MHz, and ESP-IDF's default for this target is 80 MHz, so pin DIO at
# 40 MHz explicitly. tools/check_image.py verifies the bootloader and app image headers carry exactly this.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
# Reproducible builds: no compile timestamps in the app image.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The saved Wi-Fi networks live in NVS at 0x9000 and must not move. The partition table is the C firmware's, byte for byte (partitions.csv, copied from
# the repository root and compared by tools/check_image.py); esp-idf-sys cannot take a custom table from here (its README: "do not define
# CONFIG_PARTITION_TABLE_CUSTOM"), so tools/image.sh hands it to espflash instead.

# ---- Console: the USB CDC port is the console; nothing on a UART -------------------------------------------------------------------------------------
CONFIG_ESP_CONSOLE_NONE=y

# ---- Tasks -------------------------------------------------------------------------------------------------------------------------------------------
# The C firmware's app_main stack (freed when app_main returns). Here the main task becomes the manager, so it stays.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168
# The Wi-Fi event handler (bridge::link: USB ring flush, carrier change) runs on this task.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

# ---- Wi-Fi (ADR 0022 amendment 2, ADR 0023: the bridge's buffers) ------------------------------------------------------------------------------------
# Roaming assist (v0.1.1): 802.11k neighbour reports and 802.11v BSS transition management, so the network can steer the dongle to a better access
# point. Network-assisted only.
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_RRM_SUPPORT=y
CONFIG_ESP_WIFI_WNM_SUPPORT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# RX buffers are copied out of the driver at once in bridge mode; the pool is the driver's limit.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# TX buffers copy each outgoing frame and are held until it is sent. The pool is the driver's limit, not ours: the pin budget (tdongle-wifi-budget)
# counts the buffers in flight at the one place they start and the bridge keeps six in flight (board::WIFI_TX_INFLIGHT).
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# ---- Crash evidence survives USB detach: capture only the failing task, no DRAM dump ---------------------------------------------------------------
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=1
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=n
CONFIG_ESP_COREDUMP_LOGS=n
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64

# ---- Memory: run rarely-hot system code from flash ---------------------------------------------------------------------------------------------------
# About +30 KB of boot free heap on the original board, with upload throughput unchanged (ELF-verified board A/B on 2026-10-05). Heap-allocator code
# stays in IRAM; the Wi-Fi IRAM options also stay on: moving them cost 25-30% throughput.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n

# ---- Power and latency (ADR 0016, owner-approved 2026-10-05) -------------------------------------------------------------------------------------------
# The CPU boots at 240 MHz and esp_pm_configure() (src/pm.rs) lets it scale between 240 and 80 MHz: the forwarding tasks hold a CPU-max lock while they
# have work. Light sleep stays off: no tickless idle, so USB stays enumerated and nothing sleeps the CPU.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
# The kernel tick the whole timing story assumes (pdMS_TO_TICKS(1) is 0: the bridge never sleeps on the tick, ADR 0023).
CONFIG_FREERTOS_HZ=100
